# MechGrader AI grader configuration.
#
# Copy this file to ".env" (which is gitignored) and paste your key:
#     cp .env.example .env      # then edit .env
# `make eval` loads .env automatically. Anything you `export` in the shell wins.
# NEVER commit .env — it holds a secret and is gitignored.

# 1) Which provider to call. Leave blank/unset to keep the AI grader OFF (the
#    eval then runs the RDKit baseline only and says the AI was skipped).
#    Supported by `make eval` (all OpenAI /chat/completions-compatible):
#      openai | groq | together | openrouter | azure-openai | ollama | vllm
MECHGRADER_LLM_PROVIDER=openai

# 2) Your API key. This single variable works for ANY provider above.
MECHGRADER_LLM_API_KEY=sk-your-key-here

# --- optional ---
# MECHGRADER_LLM_MODEL=gpt-4o-mini
# For a LOCAL model (no cloud key needed — use any non-empty key above):
#   MECHGRADER_LLM_PROVIDER=ollama
#   MECHGRADER_LLM_BASE_URL=http://localhost:11434/v1
#   MECHGRADER_LLM_MODEL=llama3.1
# MECHGRADER_AI_DISABLED=1     # hard kill switch: force AI OFF regardless of key
