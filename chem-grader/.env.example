# chem-grader configuration.
#
# Copy this file to ".env" (which is gitignored) and paste your key:
#     cp .env.example .env
# then edit .env. Restart the server afterward. Anything you `export` in the
# shell still takes precedence over this file.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
